# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# NestJS connects to Postgres from this file at startup (no backend/.env).

# ── Nest API ────────────────────────────────────────────────────────────────
PORT=3001
# true = skip JWT. Must be false (or unset) in any real deploy.
AUTH_DEV_BYPASS=true
# URL the Next.js frontend uses to call the NestJS API (NEXT_PUBLIC = browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Local Postgres (docker-compose) ──────────────────────────────────────────
POSTGRES_DB=elovate
POSTGRES_USER=elovate
POSTGRES_PASSWORD=elovate

# ── Flyway + Nest (same credentials) ────────────────────────────────────────
# Local default — points at the docker-compose postgres service.
# Override all three with your NeonDB values when deploying.
FLYWAY_URL=jdbc:postgresql://postgres:5432/elovate
FLYWAY_USER=elovate
FLYWAY_PASSWORD=elovate

# NeonDB (uncomment and replace when deploying):
# FLYWAY_URL=jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
# FLYWAY_USER=<neon-user>
# FLYWAY_PASSWORD=<neon-password>

# Optional. If unset, Nest builds a URL from FLYWAY_USER + FLYWAY_PASSWORD + FLYWAY_URL.
# DATABASE_URL=postgresql://elovate:elovate@localhost:5432/elovate

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
# URL of the Next.js app (used by better-auth to build absolute callback URLs)
BETTER_AUTH_URL=http://localhost:3000
# Exposed to the browser so auth-client.ts can reach the API route
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI to add: http://localhost:3000/api/auth/callback/google
# Production (Railway frontend): https://<elovate-web>.up.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Railway (two services: elovate-api + elovate-web) ────────────────────────
# Do not set AUTH_DEV_BYPASS (or set false).
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
#
# elovate-api:
#   DATABASE_URL=postgresql://...neon.tech/...?sslmode=require
#   BETTER_AUTH_URL=https://${{elovate-web.RAILWAY_PUBLIC_DOMAIN}}
#
# elovate-web:
#   API_URL is read at request time (do not rely on next.config rewrites).
#   Prefer the private URL. If ${{elovate-api.*}} is empty, use the public API URL.
#   API_URL=http://${{elovate-api.RAILWAY_PRIVATE_DOMAIN}}:${{elovate-api.PORT}}/api
#   or API_URL=https://elovate-api-production.up.railway.app/api
#   BETTER_AUTH_URL=https://${{elovate-web.RAILWAY_PUBLIC_DOMAIN}}
#   NEXT_PUBLIC_BETTER_AUTH_URL=same as BETTER_AUTH_URL
#   BETTER_AUTH_SECRET=...
#   DATABASE_URL=same Neon URL (Better Auth runs inside Next.js)
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET if using Google sign-in
